manifest {
    name = 'scanpy-scrna-pipeline'
    author = 'Xiaobin Zheng'
    description = 'Single-cell RNA-seq analysis pipeline using scanpy'
    version = '1.0.0'
    nextflowVersion = '>=23.04.0'
}

params {
    // Input/Output specifications
    input              = "samplesheet.csv"
    outdir             = './results'
    species            = "mouse" 
    custom_marker_file = null

    // Advanced Biology-Driven QC parameters
    min_cells                     = 3
    min_genes                     = 200
    max_genes                     = 8000
    min_transcripts               = 500
    max_transcripts               = 15000
    max_pct_counts_in_top_20_genes = 80.0
    max_mt_percent                = 5.0
    // 10x Genomics platform chemistry choice for automated doublet rate scaling.
    // Acceptable values: 'GEM-X' (~0.4% per 1k cells) or 'Next GEM' (~0.8% per 1k cells)
    
    // Analysis parameters
    n_top_genes       = 2000
    n_pcs             = 50
    n_neighbors       = 20
    n_pcs_umap        = 30
    leiden_resolution = 1.0
    
    // =========================================================================
    // SUBCLUSTERING PARAMETERS
    // =========================================================================
    sub_input_dir      = "./results/06_annotation" 
    custom_marker_file       = "${projectDir}/bin/marker_genes.csv" 
    interest_csv = "${projectDir}/bin/subclustering.csv" 
    sub_n_pcs       = 20                                                                                   
    sub_resolution     = 0.5                              
    sub_neighbors      = 10                               
    sub_pcs_umap       = 15      
    
    // Cell type annotation (Shared / Subclustering Config)
    annotate_celltypes = true
    marker_file        = "${projectDir}/bin/sctypepy/ScTypeDB_Full.xlsx"
    tissue_name        = "Eye" 
   
    // Resource thresholds
    max_cpus   = 8
    max_memory = '32.GB'
    max_time   = '24.h'
    
    // Container Engine Target
    container = 'docker://python:3.12'
}

process {
    // Default base resources
    cpus   = 2
    memory = '8.GB'
    time   = '2.h'
    
    errorStrategy = 'retry'
    maxRetries    = 2
    
    withName: LOAD_AND_QC {
        cpus   = 2
        memory = '12.GB' // Bumped slightly for multi-page PDF plotting arrays
    }
    
    withName: NORMALIZE_AND_HVG {
        cpus   = 4
        memory = '16.GB' // Bumped significantly to accommodate dense matrix conversion for rpy2
    }
    
    withName: DIMENSIONALITY_REDUCTION {
        cpus   = 4
        memory = '12.GB'
    }
    
    withName: CLUSTERING {
        cpus   = 4
        memory = '12.GB'
    }
    
    withName: MARKER_GENES {
        cpus   = 4
        memory = '12.GB'
    }
    
    withName: ANNOTATE_CELL_TYPES {
        cpus   = 2
        memory = '8.GB'
    }
    
    withName: VISUALIZATION {
        cpus   = 2
        memory = '8.GB'
    }
    
    withName: SUBCLUSTERING {
        cpus   = 4
        memory = '32.GB' // Bumped layout bounds to prevent subclustering filter OOM drops
    }
}

// Execution reports (FIXED: added overwrite configuration layers)
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}

// Execution profiles
profiles {
    // Standard profile - uses local Python environment
    standard {
        process.executor = 'local'
        docker.enabled   = false
        conda.enabled    = false
    }
    
    // Docker profile - uses containerized environment
    docker {
        docker.enabled    = true
        docker.runOptions = '-u \$(id -u):\$(id -g)'
        process.container = 'scanpy-pipeline:1.0.0'
        docker.temp       = 'auto'
    }
    
    // Conda profile - uses local cluster conda pathing environment
    conda {
        conda.enabled     = true
        process.conda     = "/fsx/home/l128405/miniconda3/"
        conda.cacheDir    = "${env('HOME')}/.nextflow/conda"
    }
    
    // Singularity profile - HPC clusters
    singularity {
        singularity.enabled    = true
        singularity.autoMounts  = true
        process.container      = params.container ?: 'scanpy-pipeline_1.0.0.sif'
        singularity.cacheDir   = params.singularity_cache ?: "${env('HOME')}/.nextflow/singularity"
    }
    
    // SLURM cluster with conda
    slurm_conda {
        process.executor = 'slurm'
        process.queue    = 'nvme-nextflow'
        conda.enabled    = true
        process.conda    = "${projectDir}/conda/environment.yml"
    }
    
    // SLURM cluster with singularity
    slurm_singularity {
        process.executor    = 'slurm'
        process.queue       = 'nvme-nextflow'
        singularity.enabled = true
        singularity.autoMounts = true
        process.container   = params.container ?: 'scanpy-pipeline_1.0.0.sif'
        singularity.cacheDir = params.singularity_cache ?: "${env('HOME')}/.nextflow/singularity"
    }
}